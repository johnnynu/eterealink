# syntax=docker/dockerfile:1

FROM node:24-alpine AS dependencies

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM node:24-alpine AS build

WORKDIR /app
COPY --from=dependencies /app/node_modules ./node_modules
COPY . .

ARG API_BASE_URL=http://api:8080
ARG NEXT_PUBLIC_MAX_UPLOAD_BYTES=1073741824
ARG NEXT_PUBLIC_MAX_PERSISTENT_FILE_BYTES=5368709120
ARG NEXT_PUBLIC_MAX_TRANSFER_BYTES=1073741824
ARG NEXT_PUBLIC_MAX_FILES=10
ARG NEXT_PUBLIC_FIREBASE_API_KEY
ARG NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN
ARG NEXT_PUBLIC_FIREBASE_PROJECT_ID
ARG NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET
ARG NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID
ARG NEXT_PUBLIC_FIREBASE_APP_ID

ENV API_BASE_URL=${API_BASE_URL} \
    NEXT_PUBLIC_MAX_UPLOAD_BYTES=${NEXT_PUBLIC_MAX_UPLOAD_BYTES} \
    NEXT_PUBLIC_MAX_PERSISTENT_FILE_BYTES=${NEXT_PUBLIC_MAX_PERSISTENT_FILE_BYTES} \
    NEXT_PUBLIC_MAX_TRANSFER_BYTES=${NEXT_PUBLIC_MAX_TRANSFER_BYTES} \
    NEXT_PUBLIC_MAX_FILES=${NEXT_PUBLIC_MAX_FILES} \
    NEXT_PUBLIC_FIREBASE_API_KEY=${NEXT_PUBLIC_FIREBASE_API_KEY} \
    NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=${NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN} \
    NEXT_PUBLIC_FIREBASE_PROJECT_ID=${NEXT_PUBLIC_FIREBASE_PROJECT_ID} \
    NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=${NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET} \
    NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=${NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID} \
    NEXT_PUBLIC_FIREBASE_APP_ID=${NEXT_PUBLIC_FIREBASE_APP_ID} \
    NEXT_TELEMETRY_DISABLED=1

RUN npm run build

FROM node:24-alpine AS runtime

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=3000

WORKDIR /app

RUN addgroup -S -g 10001 eterealink \
    && adduser -S -D -H -u 10001 -G eterealink eterealink

COPY --from=build --chown=eterealink:eterealink /app/public ./public
COPY --from=build --chown=eterealink:eterealink /app/.next/standalone ./
COPY --from=build --chown=eterealink:eterealink /app/.next/static ./.next/static

USER eterealink

EXPOSE 3000

HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:3000/health || exit 1

CMD ["node", "server.js"]
